prefix=D:/Projects/Cpp/ast-tool/abseil/install
exec_prefix=${prefix}
libdir=D:/Projects/Cpp/ast-tool/abseil/install/lib
includedir=D:/Projects/Cpp/ast-tool/abseil/install/include

Name: absl_span
Description: Abseil span library
URL: https://abseil.io/
Version: 20260526
Requires: absl_algorithm = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_hardening = 20260526, absl_nullability = 20260526, absl_throw_delegate = 20260526, absl_type_traits = 20260526, absl_weakly_mixed_integer = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} /W3 /bigobj /wd4005 /wd4068 /wd4180 /wd4503 /wd4800 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE
