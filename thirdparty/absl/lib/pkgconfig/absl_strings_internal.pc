prefix=D:/Projects/Cpp/ast-tool/abseil/install
exec_prefix=${prefix}
libdir=D:/Projects/Cpp/ast-tool/abseil/install/lib
includedir=D:/Projects/Cpp/ast-tool/abseil/install/include

Name: absl_strings_internal
Description: Abseil strings_internal library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_endian = 20260526, absl_raw_logging_internal = 20260526, absl_strings_resize_and_overwrite = 20260526, absl_type_traits = 20260526
Libs: -L${libdir}  -labsl_strings_internal 
Cflags: -I${includedir} /W3 /bigobj /wd4005 /wd4068 /wd4180 /wd4503 /wd4800 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE
