Description: Abseil node_hash_map library
URL: https://abseil.io/
Version: 20260526
Requires: absl_container_memory = 20260526, absl_core_headers = 20260526, absl_hash_container_defaults = 20260526, absl_node_slot_policy = 20260526, absl_raw_hash_map = 20260526, absl_algorithm_container = 20260526, absl_memory = 20260526, absl_type_traits = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} /W3 /bigobj /wd4005 /wd4068 /wd4180 /wd4503 /wd4800 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE
